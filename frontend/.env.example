# Base URL of the PayShield backend API. In local dev this is proxied by
# Vite (see vite.config.js) so it can stay empty/relative; set it explicitly
# for a production build pointed at a deployed backend.
VITE_API_URL=

# Cosmetic only — lets the UI show which mode it expects the backend to be
# in without an extra request. The backend's GET /api/health response is
# still the source of truth for the actual active mode.
VITE_APP_MODE=DEMO_MODE
