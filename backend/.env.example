# ── Core ──────────────────────────────────────────────────────────────
PORT=5000
# Local MongoDB or MongoDB Atlas URI. Required in Vercel.
MONGODB_URI=mongodb://127.0.0.1:27017/payshield
# Local only: set false to require a real MongoDB connection during development.
USE_IN_MEMORY_DB=true

# Origin allowed by CORS. Local dev defaults to the Vite dev server; in
# production set this to your deployed frontend's real origin. PayShield
# never uses a wildcard "*" CORS origin.
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-production-secret

# ── Synapse C++ VectorDB ──────────────────────────────────────────────
# Base URL of the existing Synapse C++ VectorDB (HNSW + Cosine). No trailing slash.
# Node never hardcodes localhost — the C++ VectorDB can be deployed separately later.
# Local:      VECTORDB_URL=http://localhost:8080
# Production: VECTORDB_URL=<your separately hosted VectorDB HTTPS URL>
VECTORDB_URL=http://localhost:8080

# ── Gemini ────────────────────────────────────────────────────────────
# Used ONLY for contextual reasoning/explanation. Gemini never decides
# APPROVE / REVIEW_REQUIRED / BLOCK_RECOMMENDED; the deterministic decision
# engine (backend/src/risk/decisionEngine.js) does.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Evaluation ────────────────────────────────────────────────────────
# Demo business cost assumption used only for the evaluation false-positive-cost
# metric. This is NOT a real Razorpay/industry figure — see README.
FALSE_POSITIVE_COST=100

# ── Transaction intake mode ───────────────────────────────────────────
# DEMO_MODE (default true): synthetic transactions via POST /api/transactions.
# RAZORPAY_TEST_MODE: also accept POST /api/webhooks/razorpay. Requires the
# three RAZORPAY_* variables below to be set — TEST MODE credentials only,
# never live/production Razorpay keys. Both modes can be active at once;
# PayShield's core demo never depends on Razorpay being configured.
DEMO_MODE=true
RAZORPAY_TEST_MODE=false

# ── Razorpay (OPTIONAL — Test Mode only, never live credentials) ──────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
